APP_NAME=Travora
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=travora
DB_USERNAME=travora
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@travora.test"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=

TRAVORA_DEFAULT_CURRENCY=USD
TRAVORA_DEFAULT_MARKUP=40
TRAVORA_USAGE_REFRESH=300

PROVIDER_LOG_LEVEL=basic
PROVIDER_TIMEOUT=20
PROVIDER_RECONCILE_TTL=300
PROVIDER_RETAIN_AMBIGUOUS_HOLDS=true
WALLET_HOLD_TTL_MINUTES=30
ESIMACCESS_WEBHOOK_ALLOWED_IPS=

PAYMENT_DRIVER=wallet

RATE_LIMIT_API=60
RATE_LIMIT_SENSITIVE=20
AUDIT_LOG_RETENTION_DAYS=365
PROVIDER_API_LOG_RETENTION_DAYS=14
WALLET_HOLD_TTL_MINUTES=30
WEBHOOK_MAX_ATTEMPTS=8

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
